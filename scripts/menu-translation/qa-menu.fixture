'use client'
import { MenuPageClient } from '__MENU_CLIENT__'
import { DEFAULT_THEME } from '@garsonless/design-engine'
const rid='00000000-0000-4000-8000-000000000099', cid='00000000-0000-4000-8000-000000000098'
const items=Array.from({length:30},(_,i)=>({id:`00000000-0000-4000-8000-${String(i+1).padStart(12,'0')}`,category_id:cid,name:`Etli mantı ${i+1}`,description:'250 g yoğurt ve domates sosuyla.',price:250,images:[],ingredients:[{id:'onion',name:'Soğan',removable:true,allergen_codes:[]}],energy_kcal:400,contains_allergens:['milk' as const],may_contain_allergens:[],allergen_note:null,cross_contact_note:null,contains_alcohol:false,contains_pork:false,is_vegetarian:false,is_vegan:false,is_halal:true,food_info_reviewed_at:null,modifier_groups:[],is_available:true,position:i}))
const fields=Object.fromEntries(items.flatMap(item=>[[`item/${item.id}/name`,{source:item.name,text:item.name.replace('Etli mantı','Meat dumplings')}],[`item/${item.id}/description`,{source:item.description,text:'With 250 g yoghurt and tomato sauce. '+(item.position===0 ? 'A deliberately long translation for checking wrapping and comfortable reading on a narrow screen. '.repeat(5) : '')}],[`item/${item.id}/ingredient/onion/name`,{source:'Soğan',text:'Onion'}]]))
export default function Menu({initialLocale}:{initialLocale:"tr"|"en"}){return <MenuPageClient restaurant={{id:rid,name:'Çeviri test mutfağı',slug:'translation-test',logo_url:null,settings:{},timezone:'Europe/Istanbul'}} categories={[{id:cid,restaurant_id:rid,name:'Yemekler',position:0,is_visible:true}]} items={items} theme={{...DEFAULT_THEME,sections:[],pageBlocks:[{id:cid,type:'category'}],cardLayout:'horizontal',pageDescription:'',cartPlacement:'header'}} templateId="default" guestOrderingEnabled customerAccountsEnabled={false} initialMenuLocale={initialLocale} menuTranslations={{enabled:true,revision:1,fields:{...fields,[`category/${cid}/name`]:{source:'Yemekler',text:'Dishes'}}}}/>}
