import { notFound } from 'next/navigation'
import {cookies,headers} from 'next/headers'
import {resolveMenuLocale} from '@garsonless/domain/menu-translation'
import Workspace from './Workspace'
import Panel from './Panel'
import Menu from './Menu'
import {mockSnapshot} from './actions'
export default async function Page({searchParams}:{searchParams:Promise<{view?:string;lang?:string}>}){
 if(process.env.NODE_ENV!=='development')notFound()
 const sp=await searchParams;
 if(sp.view==='menu')return <Menu initialLocale={resolveMenuLocale({enabled:true,explicit:sp.lang,saved:(await cookies()).get('masabu_menu_locale')?.value,acceptLanguage:(await headers()).get('accept-language')})}/>
 void mockSnapshot
 if(sp.view==='panel'||sp.view==='panel-failure')return <Panel restaurantId={sp.view==='panel-failure' ? "00000000-0000-4000-8000-000000000097" : "00000000-0000-4000-8000-000000000098"}/>
 return <div style={{padding:24}}><Workspace restaurantId={sp.view==='ready' ? "00000000-0000-4000-8000-000000000096" : sp.view==='flow' ? "00000000-0000-4000-8000-000000000098" : "00000000-0000-4000-8000-000000000099"}/></div>
}
