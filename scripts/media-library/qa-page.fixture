'use client'
import {useState} from 'react'
import MediaLibrary from '@/components/media-library/MediaLibrary'
import {MediaInput} from '@/components/media-library/MediaInput'
import {Button} from '@/components/ui/button'
import {Input} from '@/components/ui/input'
export default function Qa(){const [url,setUrl]=useState('');return <div className="h-dvh overflow-hidden"><main aria-label="Dosyalar sayfası" className="h-full min-h-0 overflow-y-auto"><div className="mx-auto flex min-h-full max-w-6xl flex-col gap-6 p-4 sm:p-8"><h1 className="text-2xl font-semibold">Dosyalar</h1><div className="flex flex-wrap items-center gap-3"><Input aria-label="Ürün adı" defaultValue="Kaydedilmemiş ürün" className="w-48"/><MediaInput id="qa-input" className="sr-only" restaurantId="00000000-0000-4000-8000-000000000096" context="menu" purpose="menu" onMedia={rows=>setUrl(rows[0]?.url??'')}/><Button onClick={()=>document.getElementById('qa-input')?.click()}>Ürün görseli seç</Button>{url&&<span role="status">Görsel seçildi · Kaydet ile uygulanır</span>}</div><MediaLibrary restaurantId="00000000-0000-4000-8000-000000000096"/></div></main></div>}
