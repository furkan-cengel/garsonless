# ============================================================================
# PRODUCTION ENV — placeholder template (committed). NO REAL SECRETS HERE.
# ============================================================================
# Copy the relevant block into a PER-APP, gitignored file and paste real values:
#   apps/dashboard/.env.production
#   apps/menu/.env.production
#   apps/kitchen/.env.production
#   apps/marketing/.env.production
#   apps/platform-admin/.env.production
#
# PROD Supabase project ref:  <PROD_PROJECT_REF>   (NOT the dev ref yxsegwkzyiscrxiwdeuf)
# All NEXT_PUBLIC_*_URL values are the final prod domains (set at deploy time).
# Dead keys intentionally OMITTED: ANTHROPIC_API_KEY, FAL_API_KEY (feature removed).
# Dev-only keys intentionally OMITTED from prod: MAF_KITCHEN_TOKEN, SEED_OWNER_EMAIL,
#   TEST_CAFE_B_KITCHEN_TOKEN, TEST_OWNER_B_PASSWORD (seed/test fixtures — prod has no test data).

# ──────────────────────────────────────────────────────────────────────────
# apps/dashboard/.env.production
# ──────────────────────────────────────────────────────────────────────────
# Supabase (PROD project)
NEXT_PUBLIC_SUPABASE_URL=https://<PROD_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>
# Must match Supabase Edge secret OUTBOX_WORKER_SECRET. The worker also needs:
# OUTBOX_CONSUMER_URL=https://app.masabu.co/api/internal/outbox
# OUTBOX_INBOX_CONSUMER_URL=https://app.masabu.co/api/internal/inbox
# OUTBOX_EMAIL_CONSUMER_URL=https://app.masabu.co/api/internal/notification-email
# BILLING_MAINTENANCE_URL=https://app.masabu.co/api/internal/billing-maintenance
OUTBOX_WORKER_SECRET=<prod-long-random-outbox-secret>
# Platform SaaS billing (separate from restaurant order-payment credentials).
IYZICO_BILLING_MERCHANT_ID=<prod-iyzico-billing-merchant-id>
IYZICO_BILLING_API_KEY=<prod-iyzico-billing-api-key>
IYZICO_BILLING_SECRET_KEY=<prod-iyzico-billing-secret-key>
IYZICO_BILLING_BASE_URL=https://api.iyzipay.com
IYZICO_BILLING_STARTER_PLAN_REF=<prod-starter-pricing-plan-reference>
IYZICO_BILLING_STARTER_AMOUNT_MINOR=14990
IYZICO_BILLING_PRO_PLAN_REF=<prod-pro-pricing-plan-reference>
IYZICO_BILLING_PRO_AMOUNT_MINOR=29990
IYZICO_BILLING_ENTERPRISE_PLAN_REF=<prod-enterprise-pricing-plan-reference>
IYZICO_BILLING_ENTERPRISE_AMOUNT_MINOR=59990
# Campaign SMS provider. Credentials remain server-only.
SMS_PROVIDER=netgsm
NETGSM_USERCODE=<netgsm-usercode>
NETGSM_PASSWORD=<netgsm-password>
NETGSM_MSGHEADER=<netgsm-approved-header>
# Prod domains
NEXT_PUBLIC_APP_URL=https://app.masabu.co
NEXT_PUBLIC_MENU_URL=https://menu.masabu.co
NEXT_PUBLIC_MENU_BASE_URL=https://menu.masabu.co
# Server-only target used by the authenticated KDS launch exchange.
KITCHEN_URL=https://kitchen.masabu.co
# Compatibility for any public links outside the secure launch flow.
NEXT_PUBLIC_KITCHEN_URL=https://kitchen.masabu.co
# Transactional email (Resend, prod) — also powers team invites
RESEND_API_KEY=<prod-resend-api-key>
RESEND_FROM_EMAIL=Masabu <noreply@masabu.co>
RESEND_STANDS_TO_EMAIL=stands@masabu.co
# Direct Postgres URL for tooling/migrations (PROD pooler connection string).
# Used by `supabase db push` / types:gen against PROD. Keep this secret.
SUPABASE_DB_URL=postgresql://postgres:<prod-db-password>@db.<PROD_PROJECT_REF>.supabase.co:5432/postgres

