# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Environment files — only *.example placeholders may be committed.
# Real secrets (.env.local, .env.production, etc.) stay ignored.
.env*
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example

# Next.js
.next/
**/.next/
out/

# Build outputs
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Turborepo / caches
.turbo/
**/.turbo/
.cache/
**/.cache/
.swc/
**/.swc/
tmp/

# Test and coverage artifacts
test-results/
playwright-report/
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Hosting / deploy
.vercel/
.netlify/

