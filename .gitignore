# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Environment files — only *.example placeholders may be committed.
# Real secrets (.env.local, .env.production, etc.) stay ignored.
.env*
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example
!.env.sandbox.example
!**/.env.sandbox.example

# Next.js
.next/
**/.next/
out/

# Build outputs
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Turborepo / caches
.turbo/
**/.turbo/
.cache/
**/.cache/
.swc/
**/.swc/
tmp/

# Test and coverage artifacts
test-results/
!/test-results/
/test-results/*
!/test-results/shell-entrypoints-audit/
!/test-results/shell-entrypoints-audit/REPORT.md
!/test-results/shell-entrypoints-audit/SCENARIO-MATRIX.md
!/test-results/shell-entrypoints-audit/screenshots/
!/test-results/shell-entrypoints-audit/screenshots/*.png
!/test-results/dashboard-spinner-audit/
!/test-results/dashboard-spinner-audit/REPORT.md
!/test-results/dashboard-spinner-audit/SCENARIO-MATRIX.md
!/test-results/dashboard-spinner-audit/INVENTORY.csv
!/test-results/dashboard-spinner-audit/evidence/
!/test-results/dashboard-spinner-audit/evidence/README.md
playwright-report/
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Hosting / deploy
.vercel/
.netlify/

