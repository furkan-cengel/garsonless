{
  "name": "@garsonless/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./spinners": "./src/spinners/index.tsx",
    "./spinners/styles": "./src/spinners/spinners.module.css",
    "./icons": "./src/icons/index.tsx",
    "./focus-modality": "./src/focus-modality.tsx",
    "./menu": "./src/menu/index.ts",
    "./errors": "./src/errors/RecoveryScreen.tsx",
    "./themes": "./src/themes/index.ts",
    "./themes/default": "./src/themes/default/index.ts",
    "./themes/default/settings": "./src/themes/default/settings.ts",
    "./themes/default/comboRibbonModel": "./src/themes/default/sections/comboRibbonModel.ts",
    "./menu/CartDrawer": "./src/menu/CartDrawer.tsx",
    "./menu/Header": "./src/menu/Header.tsx",
    "./menu/MenuFooter": "./src/menu/MenuFooter.tsx",
    "./menu/OrderConfirmation": "./src/menu/OrderConfirmation.tsx",
    "./menu/ProductModal": "./src/menu/ProductModal.tsx",
    "./menu/TableBillSheet": "./src/menu/TableBillSheet.tsx",
    "./menu/ThemeContext": "./src/menu/ThemeContext.tsx",
    "./themes/storeInfo": "./src/themes/storeInfo.ts",
    "./themes/default/promoSliderCampaignModel": "./src/themes/default/sections/promoSliderCampaignModel.ts",
    "./themes/default/MenuPage": "./src/themes/default/MenuPage.tsx",
    "./themes/default/CustomSectionRenderer": "./src/themes/default/sections/CustomSectionRenderer.tsx",
    "./themes/default/StorefrontSections": "./src/themes/default/sections/StorefrontSections.tsx",
    "./analytics-client": "./src/analytics-client.ts",
    "./consent-analytics": "./src/ConsentAnalytics.tsx",
    "./menu/MenuLocaleContext": "./src/menu/MenuLocaleContext.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --import tsx --test src/menu/*.test.ts src/errors/*.test.ts src/spinners/*.test.ts 'src/themes/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@garsonless/db": "workspace:*",
    "@garsonless/design-engine": "workspace:*",
    "@garsonless/domain": "workspace:*",
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "*"
  }
}
