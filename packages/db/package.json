{
  "name": "@garsonless/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./browser": "./src/browser.ts",
    "./types": "./src/types.ts",
    "./server": {
      "browser": "./src/server-browser-guard.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref yxsegwkzyiscrxiwdeuf",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff --schema public",
    "db:status": "supabase migration list",
    "db:reset": "supabase db reset",
    "types:gen": "supabase gen types typescript --linked --schema public > src/types.gen.ts",
    "verify:dashboard-insights": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-dashboard-insights-runtime.ts",
    "verify:dashboard-insights-health": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-dashboard-insights-health-runtime.ts",
    "verify:dashboard-push": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-dashboard-push-runtime.ts",
    "verify:dashboard-push-provider": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local PUSH_TEST_CONSUMER_SECRET=dashboard-push-runtime-secret node --import dotenv/config --import tsx scripts/verify-dashboard-push-provider-runtime.ts",
    "health:dashboard-insights": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/check-dashboard-insights-health.ts",
    "seed:maf": "tsx src/seed-maf.ts",
    "verify:dashboard-inbox": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-dashboard-inbox-runtime.ts",
    "verify:notification-email": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-notification-email-runtime.ts",
    "verify:saas-billing-foundation": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-saas-billing-foundation-runtime.ts",
    "verify:saas-billing-transitions": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-saas-billing-transitions-runtime.ts",
    "verify:saas-billing-webhook": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-saas-billing-webhook-runtime.ts",
    "verify:saas-billing-maintenance": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-saas-billing-maintenance-runtime.ts",
    "verify:platform-admin": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-platform-admin-runtime.ts",
    "verify:platform-tenants": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-platform-tenant-directory-runtime.ts",
    "verify:platform-tenant-operations": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/verify-platform-tenant-operations-runtime.ts",
    "bootstrap:platform-superadmin": "DOTENV_CONFIG_PATH=../../apps/dashboard/.env.local node --import dotenv/config --import tsx scripts/bootstrap-platform-superadmin.ts"
  },
  "dependencies": {
    "@garsonless/application": "workspace:*",
    "@garsonless/domain": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "supabase": "^2.98.2",
    "tsx": "^4.19.2",
    "typescript": "*"
  }
}
