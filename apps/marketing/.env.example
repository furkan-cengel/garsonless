# Dashboard URL used by marketing CTAs.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Gerçek işletme iletişim bilgileri. Production release build telefon olmadan
# fail-closed davranır. Yasal sayfalar hukuk onayından bağımsız indekslenir.
NEXT_PUBLIC_BUSINESS_PHONE=
# İsteğe bağlıdır; edinildiğinde iletişim ve KVKK başvuru sayfalarında gösterilir.
NEXT_PUBLIC_BUSINESS_KEP=
# Yalnız sayfa içindeki belge durumunu ve taslak uyarısını kontrol eder.
LEGAL_DOCS_APPROVED=false

# Business sales lead delivery (server-only).
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Masabu <bilgi@masabu.co>
RESEND_CONTACT_TO_EMAIL=bilgi@masabu.co
RESEND_SUPPORT_TO_EMAIL=destek@masabu.co
RESEND_SALES_TO_EMAIL=sales@masabu.co

# Google reCAPTCHA v2 checkbox. Local development uses Google's public test
# keys when these values are empty; production always requires real keys.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Inline interactive demos in the homepage product-flow section.
NEXT_PUBLIC_SUPADEMO_PROCESS_01_URL=https://app.supademo.com/embed/cmsodlfes0fwjqmcgjmaayv4d?embed_v=2&step=2
NEXT_PUBLIC_SUPADEMO_PROCESS_02_URL=https://app.supademo.com/embed/cmsofbs9n0k41qmcg753jbdft?embed_v=2
NEXT_PUBLIC_SUPADEMO_PROCESS_03_URL=https://app.supademo.com/embed/cmsop75r615a4qmcg5yd8c4e7?embed_v=2&step=2
NEXT_PUBLIC_SUPADEMO_PROCESS_04_URL=https://app.supademo.com/embed/cmsozp6i30gjmqm33f9oda146?embed_v=2&step=2
NEXT_PUBLIC_SUPADEMO_PROCESS_05_URL=https://app.supademo.com/embed/cmsp1k8lr0jalqm339dvlwu64?embed_v=2&step=2
NEXT_PUBLIC_SUPADEMO_PROCESS_06_URL=https://app.supademo.com/embed/cmspt8kcd005loi1yoaw96i2u?embed_v=2

# Optional GA4. Use the SAME measurement ID for marketing and dashboard.
# Tags load only with consent. Technical activation is not legal approval.
# Local development debug only: sanitized console/CustomEvent output, never Google requests.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Explicit production deployment switch; provider/transfer status is documented separately.
ANALYTICS_PRODUCTION_ENABLED=false
