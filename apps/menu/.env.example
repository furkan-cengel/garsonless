# Public Supabase project URL for customer menu data.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public Supabase anon key for customer-facing reads/realtime.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key for trusted order/payment API routes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public menu app URL for callbacks and links.
NEXT_PUBLIC_APP_URL=http://localhost:3011

# Iyzico API key for checkout creation.
IYZICO_API_KEY=your-iyzico-api-key

# Iyzico secret key for checkout signing.
IYZICO_SECRET_KEY=your-iyzico-secret-key

# Iyzico API base URL, sandbox or production.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Public menu URL used by payment callbacks and generated links.
NEXT_PUBLIC_MENU_URL=http://localhost:3011

# Versioned AES-256-GCM keyring for one-time customer auth intents.
# Generate each key with: openssl rand -base64 32
CUSTOMER_AUTH_STATE_KEYS={"active":"v1","keys":{"v1":"replace-with-32-byte-base64-key"}}

# Production is fail-closed when this variable is absent. Add a provider only
# after both its hosted configuration and callback/branding checklist pass.
# Development keeps Google as a compatibility default when the variable is absent.
CUSTOMER_AUTH_ENABLED_PROVIDERS=google

# Local/self-hosted Supabase provider contract. Keep real values in the secret
# manager or an untracked local env file; hosted values belong in Supabase.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_SECRET=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_SECRET=
# Comma-separated dashboard origins allowed to embed `?preview=1` menu pages.
# Keep empty in production until the dashboard origin is explicitly known.
DASHBOARD_PREVIEW_ORIGINS=http://localhost:3000

# ── Dev seed fixture only (packages/db/scripts/seed-test-cafe-b.ts) ──
# Working login for the "Test Cafe B" dev tenant. Local-only; never used in prod.
TEST_OWNER_B_PASSWORD=your-test-owner-b-password
TEST_CAFE_B_KITCHEN_TOKEN=your-test-cafe-b-kitchen-token
# Shared secret used by the scheduled reconciliation/outbox worker endpoints.
OUTBOX_WORKER_SECRET=your-long-random-outbox-secret
