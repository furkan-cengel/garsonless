# Public Supabase project URL for kitchen realtime/status access.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public Supabase anon key for realtime change signals.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key for token-validated kitchen server reads.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
