# Local development reuses apps/dashboard/.env.local when present so shared
# Supabase credentials are not copied. These variables remain the explicit
# deployment contract for an independently configured platform-admin runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Independent money-movement gate. Never tie refunds to the dashboard's new
# subscription sales switch.
SAAS_BILLING_FINANCIAL_OPS_ENABLED=false
