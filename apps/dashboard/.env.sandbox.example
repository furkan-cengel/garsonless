# Copy to .env.sandbox. Never commit the copied file or real credentials.
SAAS_BILLING_ENABLED=true
SAAS_BILLING_SALES_ENABLED=true
IYZICO_BILLING_MERCHANT_ID=your-sandbox-merchant-id
IYZICO_BILLING_API_KEY=your-sandbox-api-key
IYZICO_BILLING_SECRET_KEY=your-sandbox-secret-key
IYZICO_BILLING_BASE_URL=https://sandbox-api.iyzipay.com
INVOICE_VAT_RATE=20
NEXT_PUBLIC_APP_URL=https://sandbox.masabu.co
# Must match the DEV Supabase outbox-worker secret. Never commit the value.
OUTBOX_WORKER_SECRET=
# Paraşüt uses one central Masabu company. The refresh token is bootstrapped
# into DEV Supabase Vault and every rotated token is persisted there.
ACCOUNTING_WORKER_SECRET=
ACCOUNTING_WORKER_URL=https://sandbox.masabu.co/api/internal/accounting-invoices
ACCOUNTING_DISPATCH_ENABLED=false
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_REFRESH_TOKEN=
PARASUT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
PARASUT_AUTHORIZATION_CODE=
PARASUT_COMPANY_ID=
PARASUT_PRODUCT_ID=
PARASUT_API_BASE_URL=https://api.parasut.com
PARASUT_INTERNET_SALE_URL=https://sandbox.masabu.co
INVOICE_SERVICE_NAME=Masabu abonelik hizmeti
INVOICE_FROM_EMAIL=Masabu Fatura <fatura@masabu.co>
# Configure the same URL as an Edge secret named BILLING_MAINTENANCE_URL.
BILLING_MAINTENANCE_URL=https://sandbox.masabu.co/api/internal/billing-maintenance

# Filled with the non-secret output of `pnpm billing:provision-provider:sandbox`.
IYZICO_BILLING_STARTER_MONTHLY_PLAN_REF=
IYZICO_BILLING_STARTER_MONTHLY_AMOUNT_MINOR=
