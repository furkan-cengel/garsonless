# Public Supabase project URL for dashboard auth and data access.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public Supabase anon key for browser/server auth client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key for trusted dashboard server operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Platform-owned SaaS subscription billing webhook credentials. These are not
# restaurant order-payment credentials and must never reuse generic IYZICO_*.
# Keep false until live keys, base/add-on plan references, callback and webhook are
# verified together. Production checkout is fail-closed unless this is true.
SAAS_BILLING_ENABLED=false
# New checkout admission only. Lifecycle/recovery workers keep using the
# provider credentials when sales are paused. Falls back to the legacy flag
# above during rollout.
SAAS_BILLING_SALES_ENABLED=false
IYZICO_BILLING_MERCHANT_ID=your-iyzico-merchant-id
IYZICO_BILLING_API_KEY=your-iyzico-subscription-api-key
IYZICO_BILLING_SECRET_KEY=your-iyzico-subscription-secret-key
IYZICO_BILLING_BASE_URL=https://sandbox-api.iyzipay.com
# KDV oranı muhasebeci onayıyla tanımlanır. Paket kartları net (KDV hariç),
# provider tutarları ise tahsil edilecek KDV dâhil genel toplamdır.
INVOICE_VAT_RATE=
# Provider pricing-plan references and immutable gross TRY minor-unit totals.
# The adapter rejects checkout unless gross = canonical net + configured KDV.
IYZICO_BILLING_STARTER_MONTHLY_PLAN_REF=your-starter-monthly-pricing-plan-reference
IYZICO_BILLING_STARTER_MONTHLY_AMOUNT_MINOR=your-starter-monthly-gross-minor
IYZICO_BILLING_STARTER_ANNUAL_PLAN_REF=your-starter-annual-pricing-plan-reference
IYZICO_BILLING_STARTER_ANNUAL_AMOUNT_MINOR=your-starter-annual-gross-minor
IYZICO_BILLING_PLUS_MONTHLY_PLAN_REF=your-plus-monthly-pricing-plan-reference
IYZICO_BILLING_PLUS_MONTHLY_AMOUNT_MINOR=your-plus-monthly-gross-minor
IYZICO_BILLING_PLUS_ANNUAL_PLAN_REF=your-plus-annual-pricing-plan-reference
IYZICO_BILLING_PLUS_ANNUAL_AMOUNT_MINOR=your-plus-annual-gross-minor
IYZICO_BILLING_PRO_MONTHLY_PLAN_REF=your-pro-monthly-pricing-plan-reference
IYZICO_BILLING_PRO_MONTHLY_AMOUNT_MINOR=your-pro-monthly-gross-minor
IYZICO_BILLING_PRO_ANNUAL_PLAN_REF=your-pro-annual-pricing-plan-reference
IYZICO_BILLING_PRO_ANNUAL_AMOUNT_MINOR=your-pro-annual-gross-minor
# Optional Pro + Iyzico Online Payment add-on provider variants. Checkout stays
# disabled unless all six values and the matching DB catalog rows exist.
IYZICO_BILLING_PRO_IYZICO_ADDON_MONTHLY_PLAN_REF=your-pro-iyzico-addon-monthly-plan-reference
IYZICO_BILLING_PRO_IYZICO_ADDON_MONTHLY_ADDON_NET_AMOUNT_MINOR=your-addon-monthly-net-minor
IYZICO_BILLING_PRO_IYZICO_ADDON_MONTHLY_AMOUNT_MINOR=your-pro-plus-addon-monthly-gross-minor
IYZICO_BILLING_PRO_IYZICO_ADDON_ANNUAL_PLAN_REF=your-pro-iyzico-addon-annual-plan-reference
IYZICO_BILLING_PRO_IYZICO_ADDON_ANNUAL_ADDON_NET_AMOUNT_MINOR=your-addon-annual-net-minor
IYZICO_BILLING_PRO_IYZICO_ADDON_ANNUAL_AMOUNT_MINOR=your-pro-plus-addon-annual-gross-minor
# Optional Starter/Plus + Video Hero combined variants. The four variants form
# one contract; partial configuration makes billing readiness fail closed.
IYZICO_BILLING_STARTER_VIDEO_HERO_MONTHLY_PLAN_REF=your-starter-video-hero-monthly-plan-reference
IYZICO_BILLING_STARTER_VIDEO_HERO_MONTHLY_ADDON_NET_AMOUNT_MINOR=your-video-hero-monthly-net-minor
IYZICO_BILLING_STARTER_VIDEO_HERO_MONTHLY_AMOUNT_MINOR=your-starter-video-hero-monthly-gross-minor
IYZICO_BILLING_STARTER_VIDEO_HERO_ANNUAL_PLAN_REF=your-starter-video-hero-annual-plan-reference
IYZICO_BILLING_STARTER_VIDEO_HERO_ANNUAL_ADDON_NET_AMOUNT_MINOR=your-video-hero-annual-net-minor
IYZICO_BILLING_STARTER_VIDEO_HERO_ANNUAL_AMOUNT_MINOR=your-starter-video-hero-annual-gross-minor
IYZICO_BILLING_PLUS_VIDEO_HERO_MONTHLY_PLAN_REF=your-plus-video-hero-monthly-plan-reference
IYZICO_BILLING_PLUS_VIDEO_HERO_MONTHLY_ADDON_NET_AMOUNT_MINOR=your-video-hero-monthly-net-minor
IYZICO_BILLING_PLUS_VIDEO_HERO_MONTHLY_AMOUNT_MINOR=your-plus-video-hero-monthly-gross-minor
IYZICO_BILLING_PLUS_VIDEO_HERO_ANNUAL_PLAN_REF=your-plus-video-hero-annual-plan-reference
IYZICO_BILLING_PLUS_VIDEO_HERO_ANNUAL_ADDON_NET_AMOUNT_MINOR=your-video-hero-annual-net-minor
IYZICO_BILLING_PLUS_VIDEO_HERO_ANNUAL_AMOUNT_MINOR=your-plus-video-hero-annual-gross-minor

# Shared with the Supabase outbox worker. Authenticates durable event delivery
# to /api/internal/outbox; generate a long random value per environment.
OUTBOX_WORKER_SECRET=your-long-random-outbox-secret

# VAPID identity for durable browser Web Push. Generate one key pair per
# environment (`web-push generate-vapid-keys`) and keep the private key server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:ops@example.com

# Configure these URLs in the Supabase outbox worker environment, not in the
# dashboard process. New-order and billing inbox delivery plus billing e-mail
# delivery are mandatory; the worker retries instead of silently acknowledging
# those events while the corresponding consumer is missing.
# OUTBOX_PUSH_CONSUMER_URL=https://app.example.com/api/internal/push
# OUTBOX_INBOX_CONSUMER_URL=https://app.example.com/api/internal/inbox
# OUTBOX_EMAIL_CONSUMER_URL=https://app.example.com/api/internal/notification-email
# BILLING_MAINTENANCE_URL=https://app.example.com/api/internal/billing-maintenance

# Campaign delivery runs in this Node process so provider credentials stay in
# the existing server adapter rather than the Edge worker.
SMS_DELIVERY_ENABLED=false
# Set true only after company/provider activation and production acceptance.
# SMS_PROVIDER=netgsm
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=

# Dashboard public base URL for auth callbacks + team invite accept links
# (${NEXT_PUBLIC_APP_URL}/auth/accept-invite?token=...).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3003

# Signup sözleşme kanıtında ham IP yerine HMAC-benzeri tek yönlü özet üretir.
LEGAL_ACCEPTANCE_IP_SALT=generate-a-long-random-secret

# Optional HTTPS support centre. The Help surface hides the external CTA when
# this is unset or invalid and never appends tenant or user context.
# NEXT_PUBLIC_SUPPORT_URL=https://support.example.com

# Customer menu app public URL.
NEXT_PUBLIC_MENU_URL=http://localhost:3011
# Optional dedicated HMAC key for short-lived dashboard theme-preview URLs.
# Existing deployments fall back to SUPABASE_SERVICE_ROLE_KEY.
THEME_PREVIEW_SIGNING_SECRET=

# Kitchen display app public URL.
KITCHEN_URL=http://localhost:3002
NEXT_PUBLIC_KITCHEN_URL=http://localhost:3002

# Resend API key for transactional emails (QR stand requests + team invites).
# In dev, if unset the invite action returns the accept link instead of emailing.
RESEND_API_KEY=your-resend-api-key

# Sender email used by Resend (stand requests + team invite emails).
RESEND_FROM_EMAIL=Masabu <noreply@example.com>
# Resend dashboard webhook signing secret for /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret

# Recipient email for QR stand requests.
RESEND_STANDS_TO_EMAIL=stands@example.com

# Service-only accounting worker + Nilvera REST API. KDV ve hizmet açıklaması
# muhasebeci onayı olmadan production'da tanımlanmamalıdır.
ACCOUNTING_WORKER_SECRET=your-long-random-accounting-worker-secret
ACCOUNTING_WORKER_URL=https://app.masabu.co/api/internal/accounting-invoices
# Explicit release gate. Keep false until the selected provider's sandbox acceptance passes.
ACCOUNTING_DISPATCH_ENABLED=false
ACCOUNTING_PROVIDER=nilvera
# Test and live Nilvera keys are separate.
NILVERA_API_BASE_URL=https://api.nilvera.com
NILVERA_API_KEY=your-nilvera-api-key
NILVERA_SELLER_TAX_NUMBER=your-company-tax-number
NILVERA_EINVOICE_SERIES=your-einvoice-series
NILVERA_EARCHIVE_SERIES=your-earchive-series
NILVERA_INTERNET_SALE_URL=https://masabu.co
INVOICE_SERVICE_NAME=
INVOICE_FROM_EMAIL=Masabu Fatura <fatura@masabu.co>
# DEV-only canary recipient; never set this in production.
NILVERA_CANARY_EMAIL=

# Public menu base URL used for generated QR links.
NEXT_PUBLIC_MENU_BASE_URL=http://localhost:3011

# ── Dev seed fixture only (packages/db/src/seed-maf.ts) ──
# Kitchen access token written for the maf-lounge dev tenant. Local-only.
MAF_KITCHEN_TOKEN=your-maf-kitchen-token

# Device OTP rollout must be coordinated with DB enrollment (docs/auth-device-security.md).
DASHBOARD_DEVICE_SECURITY_ENABLED=false
# Opt-in server-side IPinfo risk lookup. Requires Core/Plus lookup privacy flags.
# Never prefix this secret with NEXT_PUBLIC_; never commit a real token.
DASHBOARD_IPINFO_ENABLED=false
IPINFO_TOKEN=

# Optional GA4: leave empty until Analytics account and data-transfer review are complete.
# Use the SAME stream ID for marketing and dashboard. Tags load only with consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Set true only after provider and international transfer review is completed.
ANALYTICS_DATA_TRANSFER_APPROVED=false
