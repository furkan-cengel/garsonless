# Public Supabase project URL for dashboard auth and data access.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public Supabase anon key for browser/server auth client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key for trusted dashboard server operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared with the Supabase outbox worker. Authenticates durable event delivery
# to /api/internal/outbox; generate a long random value per environment.
OUTBOX_WORKER_SECRET=your-long-random-outbox-secret

# VAPID identity for durable browser Web Push. Generate one key pair per
# environment (`web-push generate-vapid-keys`) and keep the private key server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:ops@example.com

# Configure this URL in the Supabase outbox worker environment, not in the
# dashboard process: OUTBOX_PUSH_CONSUMER_URL=https://app.example.com/api/internal/push

# Campaign delivery runs in this Node process so provider credentials stay in
# the existing server adapter rather than the Edge worker.
SMS_PROVIDER=mock
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=

# Dashboard public base URL for auth callbacks + team invite accept links
# (${NEXT_PUBLIC_APP_URL}/auth/accept-invite?token=...).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer menu app public URL.
NEXT_PUBLIC_MENU_URL=http://localhost:3011

# Kitchen display app public URL.
KITCHEN_URL=http://localhost:3002
NEXT_PUBLIC_KITCHEN_URL=http://localhost:3002

# Resend API key for transactional emails (QR stand requests + team invites).
# In dev, if unset the invite action returns the accept link instead of emailing.
RESEND_API_KEY=your-resend-api-key

# Sender email used by Resend (stand requests + team invite emails).
RESEND_FROM_EMAIL=Masabu <noreply@example.com>

# Recipient email for QR stand requests.
RESEND_STANDS_TO_EMAIL=stands@example.com

# Direct Postgres connection URL for Supabase tooling.
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Public menu base URL used for generated QR links.
NEXT_PUBLIC_MENU_BASE_URL=http://localhost:3011

# ── Dev seed fixture only (packages/db/src/seed-maf.ts) ──
# Kitchen access token written for the maf-lounge dev tenant. Local-only.
MAF_KITCHEN_TOKEN=your-maf-kitchen-token
