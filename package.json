{
  "name": "garsonless",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present --workspace-concurrency=4 build",
    "check": "corepack pnpm check:ci && corepack pnpm build && corepack pnpm smoke",
    "check:ci": "corepack pnpm deadcode:report && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:next-conventions && corepack pnpm test:architecture && corepack pnpm test:db && corepack pnpm test:prod-preflight && corepack pnpm test:prod-release && corepack pnpm test:prod-topology && corepack pnpm test:prod-runtime && corepack pnpm test:prod-smoke && corepack pnpm test:prod-handoff && corepack pnpm test:prod-candidate && corepack pnpm test:prod-execution && corepack pnpm test:prod-recovery && corepack pnpm test:prod-decision && corepack pnpm test:prod-bundle && corepack pnpm test:tables-bundle-budget && corepack pnpm test:dashboard-bundle-budget && corepack pnpm test:workspace-artifacts && corepack pnpm test:runtime-versions && corepack pnpm check:runtime-versions",
    "check:visual": "corepack pnpm check && corepack pnpm visual:smoke",
    "deadcode": "knip",
    "deadcode:report": "knip --reporter compact",
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "dev:all": "corepack pnpm -r --parallel --if-present dev",
    "dev:core": "corepack pnpm --parallel --filter @garsonless/dashboard --filter @garsonless/menu dev",
    "dev:dashboard": "corepack pnpm --filter @garsonless/dashboard dev",
    "dev:menu": "corepack pnpm --filter @garsonless/menu dev",
    "lint": "eslint .",
    "smoke": "playwright test",
    "test:marketing-readiness": "node --test scripts/marketing-analytics-config.test.mjs && playwright test --config=playwright.marketing-readiness.config.ts",
    "test:application": "corepack pnpm --filter @garsonless/application test",
    "test:media-library:browser": "node scripts/media-library/browser-check.mjs",
    "test:media-library:storage": "node scripts/media-library/storage-check.mjs",
    "test:menu-translation:browser": "node scripts/menu-translation/browser-check.mjs",
    "test:guided-setup:browser": "node scripts/guided-setup/browser-check.mjs",
    "test:architecture": "corepack pnpm test:domain && corepack pnpm test:design-engine && corepack pnpm test:application && corepack pnpm --filter @garsonless/ui test && corepack pnpm --filter @garsonless/menu test && corepack pnpm test:dashboard-architecture && corepack pnpm --filter @garsonless/kitchen test:architecture && corepack pnpm --filter @garsonless/platform-admin test:architecture",
    "test:dashboard-architecture": "corepack pnpm --filter @garsonless/dashboard test:architecture",
    "test:next-conventions": "node --test scripts/next-conventions.test.mjs",
    "test:db": "corepack pnpm --filter @garsonless/db test",
    "test:tables-runtime": "corepack pnpm --filter @garsonless/db test:tables-runtime",
    "test:tables-browser-runtime": "playwright test --config=playwright.tables-runtime.config.ts",
    "test:tables-bundle-budget": "node --test scripts/tables-bundle-budget.test.mjs",
    "test:dashboard-bundle-budget": "node --test scripts/dashboard-bundle-budget.test.mjs",
    "test:workspace-artifacts": "node --test scripts/workspace-artifacts.test.mjs",
    "test:domain": "corepack pnpm --filter @garsonless/domain test",
    "test:prod-preflight": "node --test scripts/production-readiness.test.mjs",
    "test:prod-release": "node --test scripts/migration-release.test.mjs",
    "test:prod-topology": "node --test scripts/deployment-topology.test.mjs scripts/release-evidence.test.mjs",
    "test:prod-runtime": "node --test scripts/runtime-deployment.test.mjs",
    "test:prod-smoke": "node --test scripts/business-smoke.test.mjs",
    "test:prod-handoff": "node --test scripts/production-release-handoff.test.mjs",
    "test:prod-candidate": "node --test scripts/production-release-candidate.test.mjs",
    "test:prod-execution": "node --test scripts/production-release-execution.test.mjs",
    "test:prod-recovery": "node --test scripts/production-release-recovery.test.mjs",
    "test:prod-decision": "node --test scripts/production-release-decision.test.mjs",
    "test:prod-bundle": "node --test scripts/production-release-bundle.test.mjs",
    "typecheck": "corepack pnpm -r --if-present --workspace-concurrency=4 typecheck",
    "visual:auth": "playwright test --config=playwright.visual.config.ts --project=dashboard-desktop --project=dashboard-mobile --project=dashboard-narrow --project=dashboard-tablet --project=dashboard-zoom-200",
    "visual:auth:setup": "playwright test --config=playwright.visual.config.ts --project=dashboard-auth-setup",
    "visual:coupons": "playwright test --config=playwright.coupons.config.ts",
    "visual:settings": "playwright test --config=playwright.settings.config.ts",
    "visual:smoke": "playwright test --config=playwright.visual.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "db:migrate": "corepack pnpm --filter @garsonless/db db:migrate",
    "db:login": "corepack pnpm --filter @garsonless/db db:login",
    "db:link": "corepack pnpm --filter @garsonless/db db:link",
    "db:push": "corepack pnpm --filter @garsonless/db db:push",
    "db:pull": "corepack pnpm --filter @garsonless/db db:pull",
    "db:diff": "corepack pnpm --filter @garsonless/db db:diff",
    "db:status": "corepack pnpm --filter @garsonless/db db:status",
    "db:backup": "corepack pnpm --filter @garsonless/db db:backup",
    "db:reset": "corepack pnpm --filter @garsonless/db db:reset",
    "types:gen": "corepack pnpm --filter @garsonless/db types:gen",
    "prod:preflight": "node scripts/production-readiness.mjs",
    "prod:migration-manifest": "node scripts/migration-release.mjs manifest",
    "prod:migration-drift": "node scripts/migration-release.mjs verify",
    "prod:topology": "node scripts/deployment-topology.mjs",
    "prod:runtime-manifest": "node scripts/runtime-deployment.mjs manifest",
    "prod:runtime-verify": "node scripts/runtime-deployment.mjs verify",
    "prod:release-evidence": "node scripts/release-evidence.mjs",
    "prod:rehearse": "node scripts/release-rehearsal.mjs",
    "prod:smoke-manifest": "node scripts/business-smoke.mjs manifest",
    "prod:smoke-verify": "node scripts/business-smoke.mjs verify",
    "prod:handoff": "node scripts/production-release-handoff.mjs",
    "prod:release-candidate": "node scripts/production-release-candidate.mjs",
    "prod:release-execution": "node scripts/production-release-execution.mjs",
    "prod:release-recovery": "node scripts/production-release-recovery.mjs",
    "prod:release-decision": "node scripts/production-release-decision.mjs",
    "prod:release-bundle": "node scripts/production-release-bundle.mjs",
    "check:tables-bundle-budget": "node scripts/tables-bundle-budget.mjs",
    "check:dashboard-bundle-budget": "node scripts/dashboard-bundle-budget.mjs",
    "clean:artifacts": "node scripts/workspace-artifacts.mjs clean",
    "workspace:size": "node scripts/workspace-artifacts.mjs size",
    "test:design-engine": "corepack pnpm --filter @garsonless/design-engine test",
    "check:runtime-versions": "node scripts/runtime-versions.mjs",
    "test:runtime-versions": "node --test scripts/runtime-versions.test.mjs",
    "email:preview": "corepack pnpm --filter @garsonless/db exec node --import tsx scripts/generate-email-preview.ts",
    "email:sync": "node scripts/sync-email-brand.mjs",
    "test:inventory:browser": "node scripts/inventory/browser-check.mjs",
    "test:inventory:ux": "node scripts/inventory/ux-check.mjs",
    "preview:inventory": "node scripts/inventory/preview.mjs",
    "test:social:gallery": "node assets/brand/social/p01-launch-2026-09-14/verify-gallery.mjs",
    "test:social:meta": "node assets/brand/social/p01-meta-4x5-2026-09-14/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "^1.61.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "knip": "^6.29.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.4": "0.35.4",
      "uuid@<11.1.1": "11.1.1",
      "qs@<6.16.0": "6.16.0",
      "ip-address@>=10.1.1 <10.7.0": "10.7.0",
      "nanoid@<3.3.18": "3.3.18",
      "browserslist@<=4.28.6": "4.28.8",
      "tar@<7.5.21": "^7.5.21",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "hono@<4.13.5": "^4.13.5",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "esbuild@>=0.27.3 <0.28.1": "~0.28.1"
    }
  }
}
