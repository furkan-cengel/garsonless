{
  "files.exclude": {
    "**/.next": true,
    "**/.turbo": true,
    "**/.pnpm-store": true,
    "**/coverage": true,
    "**/dist": true,
    "**/build": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/supabase/.branches": true,
    "**/supabase/.temp": true,
    "agent-skills/.git": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.pnpm-store/**": true,
    "**/node_modules/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/supabase/.branches/**": true,
    "**/supabase/.temp/**": true,
    "agent-skills/.git/**": true
  },
  "search.exclude": {
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.pnpm-store/**": true,
    "**/node_modules/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/supabase/.branches/**": true,
    "**/supabase/.temp/**": true,
    "agent-skills/.git/**": true
  },
  "search.useIgnoreFiles": true,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.maxTsServerMemory": 4096
}
