{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,ts}",
    "tests/**/*.{mjs,ts}",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "eslint.config.mjs"
  ],
  "playwright": { "config": ["playwright*.config.ts"] },
  "project": ["*.{ts,mjs}", "scripts/**/*.{mjs,ts}", "tests/**/*.{mjs,ts}"],
  "ignore": [
    "docs/audits/**/evidence/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "test-results/**",
    "packages/db/src/types.gen.ts",
    "packages/db/supabase/**",
    "tests/visual/dashboard-auth.setup.ts"
  ],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreIssues": {
    "apps/dashboard/components/menu/menu-manager-view-model.ts": ["exports"],
    "apps/dashboard/components/onboarding/onboarding-model.ts": ["exports"],
    "apps/dashboard/components/orders/order-realtime-model.ts": ["exports"],
    "apps/dashboard/components/orders/order-status.ts": ["exports", "types"],
    "apps/dashboard/components/pano/pano-live-model.ts": ["exports"],
    "apps/dashboard/components/tables/settlement-sheet-ui.tsx": ["exports"],
    "apps/dashboard/components/tables/tables-navigation-ui.tsx": ["exports"],
    "apps/dashboard/components/tables/tables-qr-property-controls.tsx": ["exports"],
    "apps/dashboard/components/theme/menu-header-editor-scope.ts": ["exports"],
    "apps/dashboard/components/theme/theme-page-flow-model.ts": ["exports"],
    "apps/dashboard/components/theme/theme-section-initial-settings.ts": ["exports"],
    "apps/dashboard/components/theme/theme-section-settings-model.ts": ["exports"],
    "apps/dashboard/components/ui/alert-dialog.tsx": ["exports"],
    "apps/dashboard/components/ui/attachment.tsx": ["exports"],
    "apps/dashboard/components/ui/avatar.tsx": ["exports"],
    "apps/dashboard/components/ui/badge.tsx": ["exports"],
    "apps/dashboard/components/ui/button-group.tsx": ["exports"],
    "apps/dashboard/components/ui/combobox.tsx": ["exports"],
    "apps/dashboard/components/ui/dropdown-menu.tsx": ["exports"],
    "apps/dashboard/components/ui/field.tsx": ["exports"],
    "apps/dashboard/components/ui/progress.tsx": ["exports"],
    "apps/dashboard/components/ui/scroll-area.tsx": ["exports"],
    "apps/dashboard/components/ui/sheet.tsx": ["exports"],
    "apps/dashboard/components/ui/table.tsx": ["exports"],
    "apps/dashboard/components/ui/tabs.tsx": ["exports"],
    "apps/dashboard/components/ui/toast.tsx": ["exports"],
    "apps/dashboard/lib/accounting/invoice-provider.ts": ["types"],
    "apps/dashboard/lib/actions/analytics.ts": ["types"],
    "apps/dashboard/lib/actions/menu.ts": ["types"],
    "apps/dashboard/lib/actions/settlement.ts": ["exports"],
    "apps/dashboard/lib/actions/tables.ts": ["types"],
    "apps/dashboard/lib/auth/access-policy.ts": ["exports"],
    "apps/dashboard/lib/billing/iyzico-subscription-config.ts": ["types"],
    "apps/dashboard/lib/queries/analytics.ts": ["exports", "types"],
    "apps/dashboard/lib/queries/insights-shared.ts": ["exports"],
    "apps/dashboard/lib/queries/tables.ts": ["types"],
    "apps/dashboard/lib/ui.tsx": ["exports"],
    "apps/marketing/components/marketingStory.ts": ["types"],
    "apps/marketing/lib/legal-identity.ts": ["exports"],
    "apps/menu/lib/combo-intent-params.ts": ["exports"],
    "apps/menu/lib/customer-auth-contract.ts": ["types"],
    "apps/menu/lib/promotion-intent.ts": ["types"],
    "packages/db/src/loyalty.ts": ["exports"],
    "packages/db/src/security.ts": ["exports"],
    "packages/db/src/sms.ts": ["exports", "types"],
    "packages/db/src/split.ts": ["exports"],
    "packages/db/src/team.ts": ["exports", "types"],
    "packages/db/src/outbox-consumer-port.ts": ["types"],
    "packages/ui/src/menu/index.ts": ["exports", "types"],
    "packages/ui/src/menu/menuFilterModel.ts": ["exports"],
    "packages/ui/src/themes/default/lib/sectionTypes.ts": ["types"],
    "packages/ui/src/themes/default/sections/GallerySection.tsx": ["exports"],
    "packages/ui/src/themes/default/sections/chefPickModel.ts": ["types"],
    "packages/ui/src/themes/default/sections/galleryModel.ts": ["exports", "types"],
    "packages/ui/src/themes/default/sections/videoHeroModel.ts": ["exports", "types"]
  },
  "workspaces": {
    "apps/*": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "middleware.ts",
        "next.config.{js,mjs,ts}",
        "components/**/*.test.{ts,tsx,mjs}",
        "lib/**/*.test.{ts,tsx,mjs}",
        "*.test.mjs"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "packages/application": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "entry": ["src/{browser,server,types}.ts", "scripts/**/*.{ts,mjs}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"]
    },
    "packages/domain": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/design-engine": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/icons/index.tsx", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
